# --- синхронизатор календаря ---
# Токен для MacroDroid (заголовок Authorization: Bearer ...)
SYNC_TOKEN=YOUR_SYNC_TOKEN

# Google: id календаря «Рабочий календарь» и ключ сервисного аккаунта
CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SA_JSON=/opt/calendar-sync/secrets/service-account.json

# пока ключа нет — пишем в память
GOOGLE_DRY_RUN=1

TZ_NAME=Europe/Moscow
DOMAIN=sync.example.com
BIND_HOST=127.0.0.1
PORT=8787
WINDOW_DAYS=14
